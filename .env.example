# -----------------------------
# AI / LLM
# -----------------------------
ENVIRONMENT=development
OPENAI_KEY=
LLM_PROVIDER=local
OLLAMA_KEY=
OLLAMA_BASE_URL=
MODEL=gpt-oss:120b-cloud
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen-plus
DASHSCOPE_TIMEOUT_SECONDS=60
EXTERNAL_REQUEST_TIMEOUT_S=30.0
EXTERNAL_MAX_RETRIES=2

# -----------------------------
# Agent
# -----------------------------
AGENT_MAX_STEPS=10
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=
AGENT_TIMEOUT_S=30.0
AGENTIC_MAX_RETRIEVAL_ATTEMPTS=2
PROMPT_VERSION=enterprise-support-v1
PIPELINE_VERSION=hybrid-agentic-v1
TRACING_ENABLED=true
TRACING_INCLUDE_QUERY_TEXT=false
# Optional override (uses long default prompt if empty)
# AGENT_SYSTEM_PROMPT=

# -----------------------------
# RAG
# -----------------------------
DEFAULT_CHUNKING_STRATEGY=fixed_window
RAG_COLLECTION_NAME=
RAG_TOP_K=12
RAG_PREFETCH_K=80
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_PDF_MAX_PAGES=300
RAG_PDF_MAX_MB=25
RAG_PDF_DEDUPE_THRESHOLD=96
BM25_ENABLED=true
DENSE_ENABLED=true
BM25_FETCH_K=40
DENSE_FETCH_K=40
HYBRID_CANDIDATE_K=40
RRF_K=60
# BM25_DATABASE_PATH=/app/data/bm25.db

RERANKER_ENABLED=false
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-v4.0-fast
RERANKER_API_KEY=
RERANKER_FAIL_OPEN=true
RERANKER_TIMEOUT_S=20.0

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-384-v1
EMBEDDING_BASE_URL=

# Optional override; default is <BASE_DIR>/data/chroma
# CHROMA_PERSIST_DIR=

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.80

QUERY_REFINEMENT_ENABLED=true
QUERY_REFINEMENT_MAX_TOKENS=64
QUERY_REFINEMENT_TEMPERATURE=0.0

# Asynchronous ingestion: background (local) or arq (Redis worker)
INGESTION_MODE=background
# INGESTION_STORAGE_DIR=/app/data/uploads
REDIS_URL=redis://localhost:6380/0
REDIS_PORT=6380
INGESTION_MAX_RETRIES=2

# -----------------------------
# Database
# -----------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
POSTGRES_DB=enterprise_support
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://admin:change_me@localhost:5432/enterprise_support

# Host bindings used by the development Docker Compose file.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# -----------------------------
# Auth / JWT
# -----------------------------
ALGORITHM=HS256
ACCESS_TOKEN_SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_TIME=30
REFRESH_TOKEN_SECRET_KEY=change_me
REFRESH_TOKEN_EXPIRE_TIME=10080
RESET_PASSWORD_TOKEN_SECRET=change_me
VERIFICATION_TOKEN_SECRET=change_me

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

# -----------------------------
# Evaluation
# -----------------------------
EVALUATION_DATA_DIR=
EVALUATION_JUDGE_ENABLED=true
EVALUATION_JUDGE_MODEL=gpt-oss:120b-cloud
EVALUATION_JUDGE_BASE_URL=
EVALUATION_JUDGE_MAX_TOKENS=256
EVALUATION_JUDGE_TEMPERATURE=0.0
EVALUATION_JUDGE_TIMEOUT_S=30.0
EVALUATION_TEXT_STRIP_PUNCTUATION=true
EVALUATION_USEFUL_CHUNK_MIN_KEYWORD_HITS=2
EVALUATION_USEFUL_CHUNK_MIN_KEYWORD_RATIO=0.4
EVALUATION_STORE_RETRIEVED_CHUNK_TEXTS=false
